# Copia este archivo a .env y completa la key. .env está en .gitignore — nunca se commitea.

# Better Auth: secreto de firma de sesión. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Interpretación IA — proveedor OpenAI-compatible (OpenRouter, Novita, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Petrografía: usa LLM_API_KEY/LLM_BASE_URL si estas claves se omiten.
# El modelo elegido debe aceptar imágenes en /chat/completions.
# PETROGRAFIA_API_KEY=
# PETROGRAFIA_BASE_URL=https://openrouter.ai/api/v1
# PETROGRAFIA_MODEL=openai/gpt-4.1

# Base de datos remota Turso (opcional; sin esto usa file:./calizas.db local)
# TURSO_URL=
# TURSO_TOKEN=

# OCR dedicado para imágenes (doubleword.ai u otro OpenAI-compatible)
OCR_API_KEY=
OCR_BASE_URL=https://api.doubleword.ai/v1
OCR_MODEL=deepseek-ai/DeepSeek-OCR-2
