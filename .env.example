# Copia este archivo a .env y completa la key. .env está en .gitignore — nunca se commitea.

# Better Auth: secreto de firma de sesión. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# IA (informes y petrografía): proveedor OpenAI-compatible. Lo guardado en
# Configuración de IA tiene prioridad sobre estas variables.
# El modelo debe aceptar imágenes en /chat/completions.
PETROGRAFIA_API_KEY=
PETROGRAFIA_BASE_URL=https://openrouter.ai/api/v1
PETROGRAFIA_MODEL=google/gemini-3.8-flash

# Base de datos remota Turso (opcional; sin esto usa file:./calizas.db local)
# TURSO_URL=
# TURSO_TOKEN=
